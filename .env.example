# =================================================================
# ANSI C AI Tutor - Environment Configuration Example
# =================================================================
# Copy this file to '.env' and customize settings.
# The app is fully offline and uses local Ollama inference!

# FastAPI General Settings
PROJECT_NAME="ANSI C AI Tutor Backend"
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"

# Local Ollama Inference Settings
# Default local URL is http://localhost:11434
# Default model is 'phi3'
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="phi3"

# Upload & Vector DB Directories
BOOKS_DIR="books"
VECTOR_DB_DIR="vector_store"
